# Core application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep false until the launch checklist and legal review are complete
SITE_INDEXABLE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEALEROS_DEMO_MODE=false
# Required when more than one active organisation shares a deployment
DEALEROS_PUBLIC_ORGANISATION_ID=
# Parent domain used for dealership subdomains, for example motoros.co.uk
MOTOROS_BASE_DOMAIN=
# Safe tenant used only for localhost development without a subdomain
MOTOROS_LOCAL_ORGANISATION_SLUG=direct-motors
# Enable only behind infrastructure that overwrites X-Forwarded-Host/Proto
MOTOROS_TRUST_PROXY_HOST=false
# Server-only Vercel credentials used by /platform to attach and verify dealer domains.
# Give this token only the access needed to manage domains on the MotorOS project.
MOTOROS_VERCEL_API_TOKEN=
MOTOROS_VERCEL_PROJECT_ID=
# Required when the MotorOS Vercel project belongs to a team.
MOTOROS_VERCEL_TEAM_ID=

# Safe public fallback identity when Supabase is unavailable
NEXT_PUBLIC_DEALERSHIP_NAME=
NEXT_PUBLIC_DEALERSHIP_PHONE=
NEXT_PUBLIC_DEALERSHIP_EMAIL=
NEXT_PUBLIC_DEALERSHIP_ADDRESS=

# Vehicle lookup
VEHICLE_LOOKUP_PROVIDER=mock
DVLA_VES_API_KEY=
DVLA_VES_BASE_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles

# Auto Trader Connect sandbox — requires an authorised agreement
AUTOTRADER_API_KEY=replace-with-sandbox-api-key
AUTOTRADER_API_SECRET=replace-with-sandbox-api-secret
AUTOTRADER_ADVERTISER_ID=replace-with-sandbox-advertiser-id
AUTOTRADER_WEBHOOK_SECRET=replace-with-sandbox-webhook-secret

# Communications (SMS delivery is not implemented in this release)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# Operations
CRON_SECRET=
# Optional emergency allow-list retained for backwards compatibility. New
# platform access should be assigned in public.platform_user_roles instead.
PLATFORM_ADMIN_EMAILS=

# Development seed controls (never point these at production)
DATABASE_URL=
SUPABASE_DB_URL=
ALLOW_REMOTE_SEED=false

# Optional live Playwright journey
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
